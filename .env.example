# AI-Onboarder Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# GOOGLE GEMINI API (Required for AI features)
# =============================================================================
# Get your API key from: https://ai.google.dev/
GOOGLE_API_KEY=

# =============================================================================
# SSO CONFIGURATION (Optional - Enable Single Sign-On)
# =============================================================================
# Configure GitHub OAuth to enable SSO authentication
# Leave blank to disable authentication (open access)

# Application URL (for OAuth callbacks)
SSO_CALLBACK_URL=http://localhost:8501

# Session timeout in seconds (default: 3600 = 1 hour)
SESSION_TIMEOUT=3600

# -----------------------------------------------------------------------------
# GITHUB OAUTH (Sign in with GitHub) - RECOMMENDED
# -----------------------------------------------------------------------------
# Quick Setup:
# 1. Go to: https://github.com/settings/developers

# 2. Click "New OAuth App"
# 3. Fill in:
#    - Application name: AI-Onboarder
#    - Homepage URL: http://localhost:8501
#    - Callback URL: http://localhost:8501/
# 4. Click "Register application"
# 5. Generate a new client secret
# 6. Copy Client ID and Secret below


# =============================================================================
# OTHER SSO PROVIDERS (Optional - Only if you need them)
# =============================================================================
# Uncomment and configure if you want additional sign-in options

# # GOOGLE OAUTH
# # Setup: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# # MICROSOFT OAUTH
# # Setup: https://portal.azure.com/
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# # OKTA
# # Setup: Okta Admin Console
# OKTA_DOMAIN=your-domain.okta.com
# OKTA_CLIENT_ID=
# OKTA_CLIENT_SECRET=

# =============================================================================
# VIDEO GENERATION (Optional)
# =============================================================================
# These settings are for video generation features
# FFMPEG_PATH=ffmpeg  # Path to ffmpeg executable
